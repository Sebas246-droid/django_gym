# ============================================================================
# Desarrollo local: copia este archivo a .env y ajusta lo que necesites.
# Sin nada configurado, corre con SQLite y archivos en disco.
# ============================================================================

SECRET_KEY=cambia-esta-llave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Base de datos ----------------------------------------------------------
# Opcion A: una sola URL (asi la entrega Railway).
# DATABASE_URL=postgres://usuario:clave@host:5432/basededatos
#
# Opcion B: PostgreSQL local por partes (p. ej. con docker compose up -d).
# POSTGRES_DB=gympilot
# POSTGRES_USER=gympilot
# POSTGRES_PASSWORD=gympilot
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Almacenamiento de media (fotos) en S3 ----------------------------------
# Si defines el bucket, las subidas van a S3; si no, quedan en disco local.
# AWS_STORAGE_BUCKET_NAME=gympilot-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=us-east-1
# Dominio publico del bucket o CDN (opcional, deja urls limpias):
# AWS_S3_CUSTOM_DOMAIN=gympilot-media.s3.us-east-1.amazonaws.com
# Endpoint propio para S3 compatible como Cloudflare R2 o MinIO (opcional):
# AWS_S3_ENDPOINT_URL=

# ============================================================================
# En Railway estas variables se definen en el panel del servicio, no en .env.
# RAILWAY_PUBLIC_DOMAIN la agrega Railway sola.
# ============================================================================
